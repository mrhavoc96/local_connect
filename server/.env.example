PORT=3000
# Postgres connection used by Prisma
# Example: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres:root123@localhost:5433/postgres

# JWT secrets (required) — copy this file to `.env` and change these values
ACCESS_TOKEN_SECRET=change_me_access_secret
REFRESH_TOKEN_SECRET=change_me_refresh_secret

# Mail / SMTP (used for signup emails in development)
MAILTRAP_HOST=smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=your_mailtrap_user
MAILTRAP_PASS=your_mailtrap_pass
MAIL_FROM=noreply@localmart.test

# CORS allowed origins (comma separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
